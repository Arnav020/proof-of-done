# Copy to .env and fill in. Never commit .env.

# PayPal SANDBOX app (developer.paypal.com > Apps & Credentials > Sandbox).
# Link the app to a US sandbox Business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI (both have free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional overrides
# GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Any long random string. Signs project state held by the browser.
STATE_SECRET=

# Local development only: lets the Inspector open localhost demo sites.
ALLOW_LOCAL_URLS=1
# Optional: path to a local Chrome/Chromium if not auto-detected.
# CHROME_PATH=
